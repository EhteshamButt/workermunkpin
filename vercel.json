{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": null,
  "functions": {
    "api/worker.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/worker",
      "destination": "/api/worker"
    },
    {
      "source": "/worker/:path*",
      "destination": "/api/worker"
    }
  ]
}

