{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/worker.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/worker",
      "destination": "/api/worker"
    },
    {
      "source": "/worker/:path*",
      "destination": "/api/worker"
    }
  ]
}

